    <DTS:Executable
      DTS:refId="Package\create schemas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AA15DFFC-08EF-4C65-A9EC-9BD081A2AFD1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create schemas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{61AFD1F3-B901-46A7-B05F-29983DD3F483}"
          SQLTask:SqlStatementSource="-- Staging database: bronze layer&#xA;USE retail_stg;&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'bronze')&#xA;    EXEC(N'CREATE SCHEMA bronze');&#xA;GO&#xA;&#xA;-- Warehouse database: silver and gold layers&#xA;USE retail_dwh;&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'silver')&#xA;    EXEC(N'CREATE SCHEMA silver');&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'gold')&#xA;    EXEC(N'CREATE SCHEMA gold');&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
